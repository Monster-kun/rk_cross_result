<launch>
    <arg name="file_folder" default="$(find-pkg-share opl_planner)/paths/"/>    
    <arg name="container_name" default="janseen_container"/>
    <node_container pkg="rclcpp_components" exec="component_container" name="$(var container_name)" namespace="" output="screen">
        <composable_node pkg="opl_planner" plugin="planning::opl_planner::OplPlanner" name="opl_planner_node">
            <param from="$(find-pkg-share opl_planner)/config/opl_planner_settings.yaml"/>
            <param name="file_folder" value="$(var file_folder)"/>
        </composable_node>
    </node_container>
</launch>