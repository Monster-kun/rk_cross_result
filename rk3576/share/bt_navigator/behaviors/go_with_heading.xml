<!--
  This Behavior Tree follows a dynamic pose to a certain distance
-->

<root BTCPP_format="4">
  <BehaviorTree ID="StraightLineMovement">
    <Sequence>
      <SwitchController controller_id="pure_pursuit_controller"/>
      <PipelineSequence name="GoStraight">
        <UpdateGoal input_goal="{goal_pose}" output_goal="{updated_goal}"/>
        <FollowPoint goal="{updated_goal}" local_planner_id="StraightLinePlanner" plan_once="true" progress_checking_mode="distance"/>
      </PipelineSequence>
      <SwitchController controller_id="halt_controller"/>
    </Sequence>
  </BehaviorTree>
</root>