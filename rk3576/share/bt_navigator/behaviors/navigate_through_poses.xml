<!--
  This Behavior Tree follows a dynamic pose to a certain distance
-->

<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <SwitchController controller_id="pure_pursuit_controller"/>
      <PipelineSequence name="NavigateThroughPoses">
        <GoalHandler distance="5.0" output_goal="{goal}">
          <ComputePathToPose goal="{goal}" path="{path}" global_planner_id="Lanelet2Planner"/>
        </GoalHandler>
        
        <FollowPath path="{path}" local_planner_id="OTLPlanner" plan_once="false" progress_checking_mode="distance" />
      </PipelineSequence>
      <SwitchController controller_id="halt_controller"/>
    </Sequence>
  </BehaviorTree>
</root>