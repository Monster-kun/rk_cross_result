<!--
  This Behavior Tree follows a dynamic pose to a certain distance
-->

<root BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <SwitchController controller_id="spinning_controller"/>
      <PipelineSequence name="SelfSpinning">
        <UpdateGoal input_goal="{goal_pose}" output_goal="{updated_goal}"/>
        <FollowPoint goal="{updated_goal}" local_planner_id="SpinningPlanner" plan_once="false" progress_checking_mode="angle"/>
      </PipelineSequence>
      <SwitchController controller_id="halt_controller"/>
    </Sequence>
  </BehaviorTree>
</root>