<!--
  This Behavior Tree follows a dynamic pose to a certain distance
-->

<root BTCPP_format="4">
  <BehaviorTree ID="GlobalPlannerTest">
    <GoalHandler distance="5.0" output_goal="{goal}">
        <ComputePathToPose goal="{goal}" path="{path}" global_planner_id="Lanelet2Planner"/>
    </GoalHandler>  
  </BehaviorTree>
</root>