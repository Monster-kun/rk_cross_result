<!--
  This Behavior Tree follows a dynamic pose to a certain distance
-->

<root BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <RecoveryControl number_of_retries="5">
      <PipelineSequence name="NavigateWithRecovery">
        <GoalHandler distance="5.0" output_goal="{goal}">
          <ComputePathToPose goal="{goal}" path="{path}" global_planner_id="Lanelet2Planner"/>
        </GoalHandler>
        <Sequence name="LocalPlanningMovement">
          <SwitchController controller_id="pure_pursuit_controller"/>
          <FollowPath path="{path}" local_planner_id="OTLPlanner" plan_once="false" progress_checking_mode="distance" />
          <SwitchController controller_id="halt_controller"/>
        </Sequence>
      </PipelineSequence>
      <RoundRobin>
        <Sequence name="StraightLineMovement">
          <SwitchController controller_id="pure_pursuit_controller"/>
          <FollowPath path="{path}" local_planner_id="StraightLinePlanner" plan_once="true" progress_checking_mode="distance" />
        </Sequence>
      </RoundRobin>
    </RecoveryControl>
  </BehaviorTree>
</root>