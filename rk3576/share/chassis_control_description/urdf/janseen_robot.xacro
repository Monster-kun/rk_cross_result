<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="swerve_drive">
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="command" default="velocity"/>
    <xacro:arg name="simulation" default="false"/>
    <xacro:arg name="settings" default=""/>
    <xacro:arg name="lidar_angle" default="1.396" />
    <link name="base_link"/>

    <!-- body -->
    <xacro:include filename="$(find chassis_control_description)/ros2_control/swerve_chassis.ros2_control.xacro"/>
    <xacro:include filename="$(find chassis_control_description)/urdf/chassis_body.xacro"/>
    <xacro:include filename="$(find chassis_control_description)/gazebo/materials.xacro"/>
    <xacro:include filename="$(find chassis_control_description)/gazebo/swerve_chassis_gz.gazebo.xacro"/>
    <!-- description -->
    <xacro:swerve parent="base_link" prefix="$(arg prefix)">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:swerve>
    <!-- gazebo claiss -->
    <xacro:if value="$(arg simulation)">
        <xacro:swerve_gazebo prefix="$(arg prefix)" settings="$(arg settings)"/>
        <!--lidar-->
        <!-- HAP -->
        <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro" />
        <xacro:VLP-16 parent="lidar_forward_link" name="velodyne" topic="/velodyne_points"
            organize_cloud="true" hz="10" min_range="0.05" min_angle="-$(arg lidar_angle)" 
            max_angle="$(arg lidar_angle)" lasers="16" samples="1440" gpu="true">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:VLP-16>

        <!-- mid 360 -->
        <!-- <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro" />
        <xacro:mid360 name="livox" parent="base_chassis_link" topic="/velodyne_points">
            <origin xyz="0.43 0 0.25" rpy="0 0 0"/>
        </xacro:mid360> -->
        

        <!--rgbd camera-->
        <xacro:include filename="$(find asus_camera_description)/urdf/asus_camera.xacro" />
        <xacro:asus_camera name="camera" parent="base_chassis_link">
            <origin xyz="0.43 0.0 0.185" rpy="0 0 0"/>
        </xacro:asus_camera>
        <!-- <xacro:include filename="$(find hk_camera_description)/urdf/hk_camera.urdf.xacro" /> -->
        <!-- <xacro:HK-camera parent="camera_forward_left_link" name="forward_left_hk_camera" topic="/forward_left_jk_camera" prefix="/forward_left">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:HK-camera> -->
        <!-- <xacro:HK-camera parent="camera_forward_right_link" name="forward_right_hk_camera" topic="/forward_right_jk_camera" prefix="/forward_right">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:HK-camera> -->

        <!--imu-->
        <xacro:include filename="$(find imu_description)/urdf/imu.urdf.xacro" />
        <xacro:FakeIMU parent="base_link">
            <origin xyz="0.0 0 0" rpy="0 0 0" />
        </xacro:FakeIMU>
    </xacro:if>

    <!-- ros2 control -->
    <xacro:swerve_control name="SwerveChassisControl" command="$(arg command)" simulation="$(arg simulation)"/>

</robot>
