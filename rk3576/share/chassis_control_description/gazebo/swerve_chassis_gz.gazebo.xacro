<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="swerve_gazebo" params="prefix settings" >
        <xacro:property name="body_color" value="silver" />
        <gazebo>
            <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
                <robot_param>robot_description</robot_param>
                <robot_param_node>robot_state_publisher</robot_param_node>
                <parameters>${settings}</parameters>
            </plugin>
        </gazebo>
        <gazebo reference="chassis_link">
            <material>${body_color}</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <selfCollide>true</selfCollide>
            <gravity>true</gravity>
        </gazebo>
        <gazebo reference="right_forward_pivot_link">
            <material>${body_color}</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <selfCollide>true</selfCollide>
        </gazebo>
        <gazebo reference="left_forward_pivot_link">
            <material>${body_color}</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <selfCollide>true</selfCollide>
        </gazebo>
        <gazebo reference="left_back_pivot_link">
            <material>${body_color}</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <selfCollide>true</selfCollide>
        </gazebo>
        <gazebo reference="right_back_pivot_link">
            <material>${body_color}</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <selfCollide>true</selfCollide>
        </gazebo>
        <gazebo reference="right_forward_drive_link">
            <material>${body_color}</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <selfCollide>true</selfCollide>
        </gazebo>        
        <gazebo reference="left_forward_drive_link">
            <material>${body_color}</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <selfCollide>true</selfCollide>
        </gazebo>
        <gazebo reference="right_back_drive_link">
            <material>${body_color}</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <selfCollide>true</selfCollide>
        </gazebo>
        <gazebo reference="left_back_drive_link">
            <material>${body_color}</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <selfCollide>true</selfCollide>
        </gazebo>
    </xacro:macro>
</robot>