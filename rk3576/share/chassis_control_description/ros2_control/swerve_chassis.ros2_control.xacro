<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="swerve_control" params="name simulation:=false command:=velocity">
  <ros2_control name="${name}" type="system">
    <hardware>
      <xacro:if value="${simulation}">
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </xacro:if>
      <xacro:unless value="${simulation}">
        <plugin>chassis_control_hardware/ChassisControlHardware</plugin>
      </xacro:unless>
    </hardware>
    <joint name="right_forward_pivot_joint">
      <command_interface name="position">
        <param name="min">-1.5707963267948966</param>
        <param name="max">1.5707963267948966</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="left_forward_pivot_joint">
      <command_interface name="position">
        <param name="min">-1.5707963267948966</param>
        <param name="max">1.5707963267948966</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="right_back_pivot_joint">
      <command_interface name="position">
        <param name="min">-1.5707963267948966</param>
        <param name="max">1.5707963267948966</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="left_back_pivot_joint">
      <command_interface name="position">
        <param name="min">-1.5707963267948966</param>
        <param name="max">1.5707963267948966</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="right_forward_drive_joint">
      <command_interface name="${command}"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>    
    <joint name="left_forward_drive_joint">
      <command_interface name="${command}"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_back_drive_joint">
      <command_interface name="${command}"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>    
    <joint name="left_back_drive_joint">
      <command_interface name="${command}"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <sensor name="cart_imu_sensor">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
    </sensor>
    </ros2_control>
</xacro:macro>

</robot>