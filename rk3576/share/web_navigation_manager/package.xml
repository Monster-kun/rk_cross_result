<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>web_navigation_manager</name>
  <version>0.1.0</version>
  <description>Independent Web navigation task manager with durable requests and safe cancellation.</description>
  <maintainer email="bgy81grant@163.com">grantou</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_action</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>behavior_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>mapping_msgs</depend>
  <depend>localization_msgs</depend>
  <depend>planning_msgs</depend>
  <depend>web_navigation_msgs</depend>
  <depend>web_navigation_core</depend>
  <depend>controller_manager_msgs</depend>
  <depend>sqlite3</depend>
  <depend>openssl</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>lifecycle_manager</exec_depend>
  <exec_depend>nav_web_gateway</exec_depend>
  <exec_depend>launcher</exec_depend>
  <exec_depend>chassis_control_bringup</exec_depend>
  <exec_depend>bt_navigator</exec_depend>
  <exec_depend>simple_action_planners</exec_depend>
