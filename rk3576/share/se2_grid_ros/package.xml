<?xml version="1.0"?>
<package format="3">
  <name>se2_grid_ros</name>
  <version>0.0.0</version>
  <description>ROS2 wrapper for SE2 grid core utilities.</description>

  <maintainer email="xulon666@gmail.com">Long Xu</maintainer>
  <author email="xulon666@gmail.com">Long Xu</author>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build and run dependencies -->
  <depend>rclcpp</depend>
  <depend>se2_grid_core</depend>
  <depend>se2_grid_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>rosbag2_cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
