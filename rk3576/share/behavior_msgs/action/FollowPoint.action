#goal definition
geometry_msgs/PoseStamped goal
string local_planner_id
bool plan_once
string progress_checking_mode # "distance" or "angle" or "all"

---
# Error codes
# Note: The expected priority order of the errors should match the message order
uint16 NONE=0
uint16 UNKNOWN=100
uint16 INVALID_PLANNER=101
uint16 INVALID_PATH=102
uint16 PATIENCE_EXCEEDED=103
uint16 FAILED_TO_MAKE_PROGRESS=104
uint16 NO_VALID_PLAN=105

#result
std_msgs/Empty result
uint16 error_code
string error_msg
---
#feedback
float32 distance_to_goal